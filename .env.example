# GATEPath 2027 local configuration. Copy this file to .env.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000

# SQLite database path. Relative paths resolve from the project root.
GATEPATH_DATABASE_PATH=backend/data/gatepath.db
# Set true behind an HTTPS reverse proxy in production. Leave false for local HTTP.
GATEPATH_SECURE_COOKIES=false

# Optional first-admin bootstrap. Use a valid email and strong unique password.
# This account is created only if the email does not already exist.
GATEPATH_ADMIN_EMAIL=
GATEPATH_ADMIN_PASSWORD=

# Optional password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional OpenAI-compatible tutor provider. Keep the key server-side only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
